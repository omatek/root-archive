{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "root-archive-moderation-staging",
  "main": "moderation.ts",
  // Match the installed workerd test runtime; advance with a toolchain upgrade.
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_ORIGIN": "https://admin-staging.rootamman.com",
    "PUBLIC_API_ORIGIN": "https://api-staging.rootamman.com",
    "ALLOWED_ORIGIN": "https://archive-staging.rootamman.com",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "GOOGLE_CLIENT_ID": "451085424306-tll56iseq0qd9lcofeb1nkiqiaq0opvh.apps.googleusercontent.com",
    "SUBMISSIONS_ENABLED": "false",
    "CLEANUP_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "root-archive-moderation-staging",
    "database_id": "f4aa2a8b-4b27-4ed3-b7a2-4e6e100a94c6",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "PRIVATE_FILES",
    "bucket_name": "root-archive-private-staging",
    "preview_bucket_name": "root-archive-private-staging-preview"
  }],
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "invocation_logs": false},
    "traces": {"enabled": true, "head_sampling_rate": 0.1}
  }
}
