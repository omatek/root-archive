{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "root-archive-worker",
  "main": "worker.ts",
  "compatibility_date": "2025-02-01",
  "workers_dev": true,

  // Public non-sensitive configuration variables.
  // Replace these placeholders with your actual values before deploying.
  "vars": {
    "GITHUB_OWNER": "YOUR_GITHUB_USERNAME_OR_ORG",
    "GITHUB_REPO": "YOUR_GITHUB_REPO_NAME",
    "ALLOWED_ORIGIN": "https://YOUR_FRONTEND_DOMAIN_OR_PAGES_URL",
    "R2_PUBLIC_BASE_URL": "https://YOUR_R2_PUBLIC_DOMAIN",
    "GOOGLE_CLIENT_ID": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },

  // Cloudflare R2 bucket binding (must be named "BUCKET" to match Env in worker.ts)
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "root-archive-assets",
      "preview_bucket_name": "root-archive-assets-preview"
    }
  ],

  "observability": {
    "enabled": true
  }
}