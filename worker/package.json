{
  "name": "root-archive-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "types:moderation": "wrangler types --config wrangler.moderation.jsonc --env-interface ModerationBindings .wrangler/moderation-env.d.ts",
    "check:moderation-bundle": "wrangler deploy --config wrangler.moderation.jsonc --dry-run --outdir .wrangler/moderation-dist",
    "dev:moderation": "wrangler dev --config wrangler.moderation.jsonc",
    "db:moderation:local": "wrangler d1 migrations apply root-archive-moderation-staging --local --config wrangler.moderation.jsonc",
    "typecheck": "npm run types:moderation && tsc --project tsconfig.json",
    "pretest": "npm run check:bundle && npm run check:moderation-bundle",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "miniflare": "5.20261023.3-beta",
    "typescript": "^5.7.3",
    "wrangler": "^4.156.0"
  }
}
