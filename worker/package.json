{
  "name": "root-archive-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "typecheck": "tsc --project tsconfig.json",
    "pretest": "npm run check:bundle",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wrangler": "^4.156.0"
  }
}
